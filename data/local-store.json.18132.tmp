        "html": "<!doctype html><html lang=\"de\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Ananta Restaurant</title><style>body{margin:0;font-family:Arial,Helvetica,sans-serif;background:#f8f8f8;color:#333}header{position:relative;width:100%;height:60vh;overflow:hidden}header img{width:100%;height:100%;object-fit:cover}header h1{position:absolute;bottom:20%;left:5%;color:#fff;font-size:3rem;text-shadow:2px2px4px rgba(0,0,0,.5)}header a{position:absolute;bottom:10%;left:5%;padding:12px 24px;background:#ff4d7e;color:#fff;text-decoration:none;border-radius:4px}section{padding:2rem 5%}section h2{color:#ff4d7e;margin-bottom:1rem}ul{list-style:none;padding:0}ul li{margin-bottom:.5rem}.gallery{display:flex;gap:1rem;overflow-x:auto}.gallery img{flex:1 1 calc(33.333% - 1rem);height:auto;border-radius:8px}footer{background:#222;color:#fff;padding:1rem 5%;text-align:center}footer a{color:#ff4d7e;text-decoration:none}</style></head><body><header><img src=\"https://picsum.photos/seed/restaurant/1600/900\" alt=\"Ananta Restaurant\"><h1>Ananta Restaurant</h1><a href=\"#contact\">Reservieren</a></header><section><h2>Dienstleistungen</h2><ul><li>Frische mediterrane Küche</li><li>Ambiente im medizinischen Stil</li><li>Reservierungen & Events</li></ul></section><section class=\"gallery\"><img src=\"https://picsum.photos/seed/restaurant-1/800/600\" alt=\"Gallery 1\"><img src=\"https://picsum.photos/seed/restaurant-2/800/600\" alt=\"Gallery 2\"><img src=\"https://picsum.photos/seed/restaurant-3/800/600\" alt=\"Gallery 3\"></section><footer><p>39 Hauptstraße, Neubiberg, 85579, DE | Tel: +49 89 66011133</p></footer></body></html>",
