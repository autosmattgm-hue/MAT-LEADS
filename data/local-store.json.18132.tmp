lex:1;text-align:center;border-radius:8px;}\n.gallery{display:flex;gap:1rem;overflow-x:auto;}\n.gallery img{width:100%;max-width:300px;border-radius:8px;}\n@media(min-width:600px){.gallery{flex-wrap:wrap;justify-content:center;}}\n</style></section><footer>© 2026 Ananta. All rights reserved.</footer><script>function showPage(i){document.querySelectorAll('.pg').forEach(function(s,idx){s.style.display=idx===i?'block':'none'});document.querySelectorAll('.nav-a').forEach(function(a,idx){a.classList.toggle('active',idx===i)});window.scrollTo(0,0);return false;}</script></body></html>",
