        "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Ananta</title><meta name=\"description\" content=\"Ananta — a professional website built to turn visitors into customers.\"><style>*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,Arial,sans-serif;color:#0f172a;background:#f8fafc;line-height:1.55}.nav{position:sticky;top:0;z-index:50;background:#0b1220;display:flex;gap:4px;align-items:center;padding:10px 16px;flex-wrap:wrap;box-shadow:0 2px 10px rgba(0,0,0,.15)}.nav .brand{color:#fff;font-weight:800;margin-right:auto;font-size:1.05rem}.nav-a{color:#cbd5e1;text-decoration:none;padding:8px 13px;border-radius:8px;font-weight:600;cursor:pointer;font-size:.95rem}.nav-a:hover{background:rgba(255,255,255,.1);color:#fff}.nav-a.active{background:#22c55e;color:#06281a}img{max-width:100%;height:auto}.wrap{max-width:1080px;margin:0 auto;padding:30px 20px}input,textarea{font:inherit}footer{background:#0b1220;color:#cbd5e1;text-align:center;padding:20px;font-size:.9rem}</style></head><body><nav class=\"nav\"><span class=\"brand\">Ananta</span><a href=\"#\" class=\"nav-a active\" onclick=\"return showPage(0)\">Home</a><a href=\"#\" class=\"nav-a\" onclick=\"return showPage(1)\">About</a><a href=\"#\" class=\"nav-a\" onclick=\"return showPage(2)\">Services</a><a href=\"#\" class=\"nav-a\" onclick=\"return showPage(3)\">Contact</a></nav><section class=\"pg\" id=\"pg-0\"><style>\nbody{font-family:Arial,Helvetica,sans-serif;margin:0;padding:0;color:#333;background:#f9f9f9;}\nh1,h2,h3{color:#004d40;}\na{color:#004d40;text-decoration:none;}\nbutton{background:#004d40;color:#fff;padding:10px 20px;border:none;border-radius:4px;cursor:pointer;}\nsection{padding:60px 20px;max-width:1200px;margin:auto;}\n.hero{background:url(https://picsum.photos/seed/restaurant/1600/900) center/cover no-repeat;height:90vh;display:flex;align-items:center;justify-content:center;flex-direction:column;color:#fff;text-align:center;}\n.hero h1{font-size:3rem;margin:0;}\n.hero button{margin-top:20px;}\n.intro{font-size:1.2rem;line-height:1.5;margin-top:20px;}\n.highlights{display:flex;gap:20px;margin-top:40px;}\n.highlight{flex:1;background:#e0f2f1;padding:20px;border-radius:8px;text-align:center;}\n.gallery{display:flex;gap:10px;margin-top:40px;overflow-x:auto;}\n.gallery img{height:200px;border-radius:8px;}\n.about p{margin:20px 0;}\n.values{display:flex;gap:20px;margin-top:30px;}\n.values div{flex:1;background:#e0f2f1;padding:20px;border-radius:8px;}\n.services-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(250px,1fr));gap:20px;margin-top:40px;}\n.service{background:#e0f2f1;padding:20px;border-radius:8px;}\n.packages{display:flex;gap:20px;margin-top:40px;}\n.package{flex:1;background:#e0f2f1;padding:20px;border-radius:8px;text-align:center;}\nform{display:flex;flex-direction:column;gap:15px;margin-top:20px;}\nform input,form textarea{padding:10px;border:1px solid #ccc;border-radius:4px;}\nform button{align-self:flex-start;}\n.contact-info{margin-top:30px;}\n</style>\n<section class=\"hero\">\n<h1>Welcome to Ananta</h1>\n<button>Reserve a Table</button>\n</section>\n<section>\n<p class=\"intro\">Experience modern dining in the heart of Neubiberg. Fresh flavors, elegant atmosphere.</p>\n<div class=\"highlights\">\n<div class=\"highlight\"><h3>Farm Fresh</h3><p>Locally sourced ingredients.</p></div>\n<div class=\"highlight\"><h3>Chef's Specials</h3><p>Seasonal menu crafted by our head chef.</p></div>\n<div class=\"highlight\"><h3>Cozy Ambience</h3><p>Modern décor with warm lighting.</p></div>\n</div>\n<div class=\"gallery\">\n<img src=\"https://picsum.photos/seed/restaurant-1/800/600\" alt=\"Dish 1\">\n<img src=\"https://picsum.photos/seed/restaurant-2/800/600\" alt=\"Dish 2\">\n<img src=\"https://picsum.photos/seed/restaurant-3/800/600\" alt=\"Dish 3\">\n</div>\n</section></section>\n<section class=\"pg\" id=\"pg-1\" style=\"display:none\"><section>\n<h2>Our Story</h2>\n<p>Founded in 2020, Ananta blends contemporary culinary techniques with traditional German flavors, creating a unique dining experience.</p>\n<h3>Why Choose Us</h3>\n<p>We prioritize sustainability, local sourcing, and impeccable service to ensure every visit is memorable.</p>\n<h3>Trust Points</h3>\n<ul>\n<li>Certified organic ingredients</li>\n<li>Positive reviews on TripAdvisor</li>\n<li>Awarded Best Modern Restaurant 2023</li>\n</ul>\n<h3>Values & Team</h3>\n<div class=\"values\">\n<div><h4>Integrity</h4><p>Transparent practices and honest pricing.</p></div>\n<div><h4>Innovation</h4><p>Constant menu evolution.</p></div>\n<div><h4>Community</h4><p>Supporting local farmers.</p></div>\n</div>\n</section></section>\n<section class=\"pg\" id=\"pg-2\" style=\"display:none\"><section>\n<h2>Our Services</h2>\n<div class=\"services-grid\">\n<div class=\"service\"><h3>Fine Dining</h3><p>Elegant table settings for special occasions.</p></div>\n<div class=\"service\"><h3>Private Events</h3><p>Venue for weddings, corporate events.</p></div>\n<div class=\"service\"><h3>Takeaway</h3><p>Freshly prepared meals for home.</p></div>\n<div class=\"service\"><h3>Catering</h3><p>Custom menus for parties.</p></div>\n<div class=\"service\"><h3>Wine Pairing</h3><p>Expert selections to complement dishes.</p></div>\n<div class=\"service\"><h3>Chef's Table</h3><p>Intimate experience with the chef.</p></div>\n</div>\n<h3>Packages & Pricing</h3>\n<div class=\"packages\">\n<div class=\"package\"><h4>Starter</h4><p>€25 per person</p></div>\n<div class=\"package\"><h4>Standard</h4><p>€45 per person</p></div>\n<div class=\"package\"><h4>Premium</h4><p>€65 per person</p></div>\n</div>\n</section></section>\n<section class=\"pg\" id=\"pg-3\" style=\"display:none\"><section>\n<h2>Contact Us</h2>\n<form action=\"#\" method=\"post\">\n<input type=\"text\" name=\"name\" placeholder=\"Your Name\" required>\n<input type=\"email\" name=\"email\" placeholder=\"Your Email\" required>\n<textarea name=\"message\" rows=\"5\" placeholder=\"Your Message\" required></textarea>\n<button type=\"submit\">Send Message</button>\n</form>\n<div class=\"contact-info\">\n<p>Phone: <a href=\"tel:+498966011133\">+49 89 66011133</a></p>\n<p>Address: 39, Hauptstraße, Neubiberg, 85579, DE</p>\n<p>Hours: Mon-Fri 11:00-22:00, Sat-Sun 10:00-23:00</p>\n<button onclick=\"window.location='tel:+498966011133'\">Call Now</button>\n</div>\n</section></section><footer>© 2026 Ananta. All rights reserved.</footer><script>function showPage(i){document.querySelectorAll('.pg').forEach(function(s,idx){s.style.display=idx===i?'block':'none'});document.querySelectorAll('.nav-a').forEach(function(a,idx){a.classList.toggle('active',idx===i)});window.scrollTo(0,0);return false;}</script></body></html>",
