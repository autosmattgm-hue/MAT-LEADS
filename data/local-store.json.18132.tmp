        "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Test Bakery</title><meta name=\"description\" content=\"Test Bakery — a professional website built to turn visitors into customers.\"><style>*{box-sizing:border-box}body{margin:0;font-family:'Segoe UI',Inter,system-ui,Arial,sans-serif;color:#16233a;background:linear-gradient(180deg,#f4f6fb 0%,#eef2f7 100%);line-height:1.6}img{max-width:100%;height:auto;border-radius:14px}.nav{position:sticky;top:0;z-index:50;background:rgba(255,255,255,.92);display:flex;gap:6px;align-items:center;padding:12px 20px;flex-wrap:wrap;box-shadow:0 2px 14px rgba(15,23,42,.1);backdrop-filter:blur(10px)}.nav .brand{font-weight:800;margin-right:auto;font-size:1.08rem;letter-spacing:-.01em}.nav-a{color:#334155;text-decoration:none;font-weight:600;padding:9px 15px;border-radius:999px;font-size:.9rem;transition:all .2s}.nav-a.active,.nav-a:hover{background:#0f172a;color:#fff}.pg{max-width:1140px;margin:0 auto;padding:28px 22px 48px}.site-foot{background:#0f172a;color:#cbd5e1;text-align:center;padding:26px;font-size:.88rem}form.site-form{display:grid;gap:10px;max-width:520px}input,textarea,select{padding:12px;border:1px solid #cbd5e1;border-radius:10px;font:inherit;width:100%}button{cursor:pointer}</style></head><body><nav class=\"nav\"><span class=\"brand\">Test Bakery</span><a href=\"#\" class=\"nav-a active\" onclick=\"return showPage(0)\">Home</a></nav><section class=\"pg\" id=\"pg-0\"><img src=\"https://picsum.photos/seed/bakery/1600/900\" alt=\"Test Bakery — professional bakery\" style=\"width:100%;max-height:440px;object-fit:cover;display:block\"><div class=\"wrap\" style=\"text-align:center\"><p style=\"letter-spacing:3px;text-transform:uppercase;font-size:12px;color:#64748b;margin:18px 0 0;font-weight:700\">bakery</p><h1 style=\"font-size:clamp(2rem,5.4vw,3.4rem);margin:.2em 0;color:#0f172a\">Test Bakery</h1><p style=\"max-width:660px;margin:0 auto;color:#475569;font-size:1.08rem;line-height:1.6\">Professional, reliable bakery you can count on. Clear pricing, fast response, and work we stand behind — so getting started is easy.</p><div style=\"display:flex;gap:12px;justify-content:center;flex-wrap:wrap;margin-top:18px\"><a href=\"#contact\" style=\"padding:14px 28px;border-radius:12px;background:#0f172a;color:#fff;font-weight:700;text-decoration:none\">Get a free quote</a></div><div style=\"display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin-top:22px\"><span style=\"background:#eef2f7;border:1px solid #e2e8f0;color:#334155;padding:8px 15px;border-radius:999px;font-size:.84rem;font-weight:600\">Licensed &amp; insured</span><span style=\"background:#eef2f7;border:1px solid #e2e8f0;color:#334155;padding:8px 15px;border-radius:999px;font-size:.84rem;font-weight:600\">Fast, friendly service</span><span style=\"background:#eef2f7;border:1px solid #e2e8f0;color:#334155;padding:8px 15px;border-radius:999px;font-size:.84rem;font-weight:600\">Free, no-obligation quotes</span><span style=\"background:#eef2f7;border:1px solid #e2e8f0;color:#334155;padding:8px 15px;border-radius:999px;font-size:.84rem;font-weight:600\">Proudly local</span></div></div><div class=\"wrap\"><div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:16px;margin-top:6px\"><div style=\"background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:20px\"><h3 style=\"margin:.1em 0 .3em\">Quality you can trust</h3><p style=\"margin:0;color:#475569\">Careful work and honest advice on every single job.</p></div><div style=\"background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:20px\"><h3 style=\"margin:.1em 0 .3em\">Clear, upfront pricing</h3><p style=\"margin:0;color:#475569\">Know the cost before we begin — no hidden fees.</p></div><div style=\"background:#fff;border:1px solid #e2e8f0;border-radius:14px;padding:20px\"><h3 style=\"margin:.1em 0 .3em\">Here when you need us</h3><p style=\"margin:0;color:#475569\">Quick response and friendly support after the job.</p></div></div><div style=\"display:grid;grid-template-columns:repeat(auto-fit,minmax(180px,1fr));gap:14px;margin-top:22px\"><img src=\"https://picsum.photos/seed/bakery-1/800/600\" alt=\"Test Bakery\" style=\"width:100%;height:180px;object-fit:cover;border-radius:12px\"><img src=\"https://picsum.photos/seed/bakery-2/800/600\" alt=\"Test Bakery\" style=\"width:100%;height:180px;object-fit:cover;border-radius:12px\"><img src=\"https://picsum.photos/seed/bakery-3/800/600\" alt=\"Test Bakery\" style=\"width:100%;height:180px;object-fit:cover;border-radius:12px\"></div></div></section><footer class=\"site-foot\">© 2026 Test Bakery. All rights reserved.<br><span style=\"opacity:.75;font-size:.82rem\">Website crafted with MAT LEADS AI Website Studio — created by Ebube John Okoye.</span></footer><script>function showPage(i){document.querySelectorAll('.pg').forEach(function(s,idx){s.style.display=idx===i?'block':'none'});document.querySelectorAll('.nav-a').forEach(function(a,idx){a.classList.toggle('active',idx===i)});window.scrollTo(0,0);return false;}</script></body></html>",
