        "html": "<!DOCTYPE html>\n<html lang=\"de\">\n<head>\n<meta charset=\"UTF-8\">\n<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\">\n<title>Ananta – Restaurant in Neubiberg | Asiatische Küche &amp; Reservierung</title>\n<meta name=\"description\" content=\"Ananta Restaurant in Neubiberg – frische, moderne Küche an der Hauptstraße 39. Jetzt Tisch reservieren: ☎ +49 89 66011133\">\n<meta property=\"og:title\" content=\"Ananta – Restaurant Neubiberg\">\n<meta property=\"og:description\" content=\"Moderne Küche in Neubiberg. Tisch reservieren: +49 89 66011133\">\n<style>\n*{margin:0;padding:0;box-sizing:border-box;font-family:'Segoe UI',system-ui,sans-serif}\n:root{--e:#0b7a4b;--ed:#065f38;--el:#e8f6ef;--ink:#12241c;--gold:#c9a24b}\nbody{color:var(--ink);line-height:1.6}\n.wrap{max-width:1080px;margin:0 auto;padding:0 20px}\nheader{position:sticky;top:0;background:#fff;box-shadow:0 1px 8px rgba(0,0,0,.06);z-index:50}\n.nav{display:flex;justify-content:space-between;align-items:center;padding:14px 0}\n.logo{font-size:1.4rem;font-weight:800;color:var(--ed);letter-spacing:1px}\n.logo span{color:var(--gold)}\n.btn{display:inline-block;background:var(--e);color:#fff;padding:12px 22px;border-radius:40px;text-decoration:none;font-weight:700;transition:.2s}\n.btn:hover{background:var(--ed)}\n.btn.wa{background:#25d366}\n.hero{background:linear-gradient(rgba(4,40,25,.72),rgba(4,40,25,.72)),url('https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1600&q=70') center/cover;color:#fff;text-align:center;padding:90px 20px}\n.hero h1{font-size:clamp(2rem,5vw,3.2rem);margin-bottom:12px}\n.hero p{font-size:1.15rem;max-width:560px;margin:0 auto 26px;opacity:.92}\n.cta-row{display:flex;gap:12px;justify-content:center;flex-wrap:wrap}\nsection{padding:64px 0}\nh2{text-align:center;font-size:1.9rem;color:var(--ed);margin-bottom:8px}\n.sub{text-align:center;color:#5a6f64;margin-bottom:36px}\n.grid{display:grid;gap:20px;grid-template-columns:1fr}\n.card{background:var(--el);border-radius:14px;padding:26px;text-align:center}\n.card .ic{font-size:2rem}\n.card h3{color:var(--ed);margin:8px 0 6px}\n@media(min-width:760px){.grid{grid-template-columns:repeat(3,1fr)}}\n.reviews{background:var(--el)}\n.rev{background:#fff;border-radius:14px;padding:22px;box-shadow:0 2px 10px rgba(0,0,0,.05)}\n.stars{color:var(--gold);letter-spacing:2px}\n.rev p{font-style:italic;margin:8px 0}\n.rev b{color:var(--ed)}\n.quote{background:var(--ed);color:#fff;text-align:center}\n.quote blockquote{font-size:clamp(1.2rem,3vw,1.7rem);font-style:italic;max-width:700px;margin:0 auto}\n.quote cite{display:block;margin-top:14px;color:var(--gold);font-style:normal;font-weight:700}\n.contact{background:var(--el)}\n.form{max-width:560px;margin:0 auto;background:#fff;padding:28px;border-radius:16px;box-shadow:0 4px 18px rgba(0,0,0,.08)}\nlabel{font-weight:600;font-size:.9rem;display:block;margin:12px 0 4px}\ninput,select,textarea{width:100%;padding:12px;border:1px solid #cfe3d8;border-radius:8px;font-size:1rem}\ntextarea{resize:vertical;min-height:80px}\n.form .btn{width:100%;margin-top:18px;border:none;cursor:pointer;font-size:1.05rem}\n.ok{display:none;background:#d9f4e6;color:var(--ed);padding:12px;border-radius:8px;margin-top:14px;text-align:center;font-weight:600}\n.info{text-align:center;margin:22px 0 0;color:#41564b;font-size:.95rem}\nfooter{background:var(--ink);color:#cfe3d8;text-align:center;padding:28px",
