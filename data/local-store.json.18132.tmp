        "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Your Business</title><meta name=\"description\" content=\"Your Business — a professional website built to turn visitors into customers.\"><style>*{box-sizing:border-box}body{margin:0;font-family:'Space Grotesk',Inter,system-ui,sans-serif;color:#0f172a;background:#ffffff;line-height:1.55}img{max-width:100%;height:auto}.nav{position:sticky;top:0;z-index:50;background:#4f46e5;display:flex;gap:6px;align-items:center;padding:10px 16px;flex-wrap:wrap;box-shadow:0 1px 8px rgba(15,23,42,.08);backdrop-filter:blur(8px)}.nav-a{color:#e0e7ff;text-decoration:none;font-weight:600;padding:8px 13px;border-radius:9px;font-size:.9rem}.nav-a.active,.nav-a:hover{background:#bef264;color:#0f172a}.nav .brand{font-weight:800;margin-right:auto;font-size:1.02rem}.pg{max-width:1120px;margin:0 auto;padding:26px 20px 40px}.site-foot{background:#0f172a;color:#cbd5e1;text-align:center;padding:24px;font-size:.88rem}form.site-form{display:grid;gap:10px;max-width:520px}input,textarea,select{padding:12px;border:1px solid #cbd5e1;border-radius:10px;font:inherit;width:100%}button{cursor:pointer}</style></head><body><nav class=\"nav\"><span class=\"brand\">Your Business</span><a href=\"#\" class=\"nav-a active\" onclick=\"return showPage(0)\">Home</a></nav><section class=\"pg\" id=\"pg-0\"><style>\n.your-busines-home-hero{display:flex;align-items:center;justify-content:space-between;padding:4rem 2rem;background:#ffffff;}\n.your-busines-home-hero h1{font-family:\"Space Grotesk\",sans-serif;font-size:3rem;color:#0f172a;flex:1;}\n.your-busines-home-hero img{border-radius:1rem;max-width:50%;height:auto;}\n.your-busines-home-stats{display:flex;justify-content:space-around;text-align:center;padding:2rem 0;}\n.your-busines-home-stats div{font-size:2rem;color:#4f46e5;}\n.your-busines-home-card{background:#f1f5f9;border-radius:.5rem;padding:1.5rem;margin:1rem 0;box-shadow:0 4px 6px rgba(0,0,0,.1);}\n.your-busines-home-card h3{color:#0f172a;font-size:1.5rem;}\n.your-busines-home-card p{color:#8b8b8b;}\n.your-busines-home-cta{margin-top:2rem;}\n.your-busines-home-form{background:#f1f5f9;padding:2rem;border-radius:.5rem;margin-top:2rem;}\n.your-busines-home-form input,.your-busines-home-form textarea{width:100%;padding:.5rem;margin:.5rem 0;border:1px solid #d1d5db;border-radius:.25rem;}\n.your-busines-home-form button{background:#4f46e5;color:#ffffff;padding:.75rem 1.5rem;border:none;border-radius:.25rem;}\n</style>\n\n<div class=\"your-busines-home-hero\">\n  <h1>Elevate Your Vision with <span style=\"text-decoration:underline;\">Bold Design</span></h1>\n  <div>\n    <a href=\"#\" class=\"your-busines-home-cta\">Get Started</a>\n    <a href=\"#\" class=\"your-busines-home-cta\">Learn More</a>\n  </div>\n  <img src=\"https://picsum.photos/seed/business/1600/900\" alt=\"Hero\">\n</div>\n\n<div class=\"your-busines-home-stats\">\n  <div>1,200+</div>\n  <div>350+</div>\n  <div>98%</div>\n  <div>24/7 Support</div>\n</div>\n\n<div class=\"your-busines-home-card\">\n  <h3>Creative Strategy</h3>\n  <p>Tailored to your goals.</p>\n  <a href=\"#\">Read More</a>\n</div>\n<div class=\"your-busines-home-card\">\n  <h3>Responsive Design</h3>\n  <p>Seamless on all devices.</p>\n  <a href=\"#\">Read More</a>\n</div>\n<div class=\"your-busines-home-card\">\n  <h3>SEO & Analytics</h3>\n  <p>Drive traffic and insight.</p>\n  <a href=\"#\">Read More</a>\n</div>\n\n<img src=\"https://picsum.photos/seed/business-1/800/600\" alt=\"Gallery\">\n<p>Our portfolio showcases diverse projects, each crafted with precision and creativity.</p>\n\n<details>\n  <summary>What services do you offer?</summary>\n  <p>We provide full-service design, development, and digital marketing solutions.</p>\n</details>\n<details>\n  <summary>How long does a project take?</summary>\n  <p>Project timelines vary; we estimate each on a case-by-case basis.</p>\n</details>\n<details>\n  <summary>Can I view a portfolio before starting?</summary>\n  <p>Absolutely, please request a detailed case study.</p>\n</details>\n\n<form class=\"your-busines-home-form\">\n  <input type=\"text\" placeholder=\"Name\" required>\n  <input type=\"email\" placeholder=\"Email\" required>\n  <input type=\"tel\" placeholder=\"Phone\">\n  <textarea placeholder=\"Message\" rows=\"4\"></textarea>\n  <button type=\"submit\">Send Message</button>\n</form></section><footer>© 2026 Your Business. All rights reserved.<br><span style=\"opacity:.75;font-size:.82rem\">Website crafted with MAT LEADS AI Website Studio — created by Ebube John Okoye.</span></footer><script>function showPage(i){document.querySelectorAll('.pg').forEach(function(s,idx){s.style.display=idx===i?'block':'none'});document.querySelectorAll('.nav-a').forEach(function(a,idx){a.classList.toggle('active',idx===i)});window.scrollTo(0,0);return false;}</script></body></html>",
