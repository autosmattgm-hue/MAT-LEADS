        "html": "<!doctype html><html lang=\"en\"><head><meta charset=\"utf-8\"><meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>Lakeside Dental Studio</title><meta name=\"description\" content=\"Lakeside Dental Studio — a professional website built to turn visitors into customers.\"><style>*{box-sizing:border-box}body{margin:0;font-family:Inter,system-ui,Arial,sans-serif;color:#0f172a;background:#f8fafc;line-height:1.55}.nav{position:sticky;top:0;z-index:50;background:#0b1220;display:flex;gap:4px;align-items:center;padding:10px 16px;flex-wrap:wrap;box-shadow:0 2px 10px rgba(0,0,0,.15)}.nav .brand{color:#fff;font-weight:800;margin-right:auto;font-size:1.05rem}.nav-a{color:#cbd5e1;text-decoration:none;padding:8px 13px;border-radius:8px;font-weight:600;cursor:pointer;font-size:.95rem}.nav-a:hover{background:rgba(255,255,255,.1);color:#fff}.nav-a.active{background:#22c55e;color:#06281a}img{max-width:100%;height:auto}.wrap{max-width:1080px;margin:0 auto;padding:30px 20px}input,textarea{font:inherit}footer{background:#0b1220;color:#cbd5e1;text-align:center;padding:20px;font-size:.9rem}</style></head><body><nav class=\"nav\"><span class=\"brand\">Lakeside Dental Studio</span><a href=\"#\" class=\"nav-a active\" onclick=\"return showPage(0)\">Home</a></nav><section class=\"pg\" id=\"pg-0\"><style>\nbody{margin:0;font-family:Arial,sans-serif;background:#f4f4f4;color:#333;}\nh1{font-size:2.5rem;margin:0.5em 0;}\nh2{font-size:1.75rem;margin:0.5em 0;}\np{line-height:1.6;}\nbutton{background:#009688;color:#fff;border:none;padding:0.75em 1.5em;font-size:1rem;cursor:pointer;border-radius:4px;}\nsection{padding:2em 1em;}\n.hero{background:url('https://picsum.photos/seed/dentist/1600/900') center/cover no-repeat;height:60vh;display:flex;flex-direction:column;justify-content:center;align-items:center;color:#fff;text-align:center;}\n.hero h1{font-size:3rem;text-shadow:2px 2px 4px rgba(0,0,0,0.5);}\n.hero button{margin-top:1em;}\n.highlights{display:flex;justify-content:space-around;flex-wrap:wrap;}\n.highlight{flex:1 1 30%;margin:1em;background:#fff;padding:1em;border-radius:8px;box-shadow:0 2px 5px rgba(0,0,0,0.1);}\n.gallery{display:flex;flex-wrap:wrap;gap:1em;}\n.gallery img{flex:1 1 calc(33% - 1em);height:auto;border-radius:8px;}\n@media(max-width:768px){.highlights{flex-direction:column;align-items:center;} .highlight{flex:1 1 80%;} .gallery img{flex:1 1 100%;}}\n</style></section><footer>© 2026 Lakeside Dental Studio. All rights reserved.</footer><script>function showPage(i){document.querySelectorAll('.pg').forEach(function(s,idx){s.style.display=idx===i?'block':'none'});document.querySelectorAll('.nav-a').forEach(function(a,idx){a.classList.toggle('active',idx===i)});window.scrollTo(0,0);return false;}</script></body></html>",
